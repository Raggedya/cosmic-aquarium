{
  "name": "project-b-side",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "node --experimental-strip-types scripts/build-github-pages.mjs",
    "catalogue:bulk-status": "python scripts/bulk_library_status.py",
    "catalogue:melbourne-geography": "python scripts/refresh_melbourne_geography.py",
    "catalogue:melbourne-audit": "python scripts/audit_melbourne_universe.py",
    "machine:prepare": "python scripts/artist_machine_factory.py prepare",
    "machine:attach-skin": "python scripts/artist_machine_factory.py attach-skin",
    "machine:check": "python scripts/artist_machine_factory.py check",
    "machine:preview": "python scripts/artist_machine_factory.py preview",
    "machine:approve": "python scripts/artist_machine_factory.py approve",
    "test:machine-factory": "python -m unittest tests.artist_machine_factory_test",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
